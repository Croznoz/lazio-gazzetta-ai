# ID del canale (UC seguito da 22 caratteri), non l'URL della ricerca YouTube.
YOUTUBE_CHANNEL_ID=UCWOuIQE2PPdTDb_CEeaoqDA
# Alternativa all'ID: URL https://www.youtube.com/feeds/videos.xml?channel_id=UC...
YOUTUBE_FEED_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
MAX_VIDEOS_PER_RUN=3
# Intervallo minimo fra gli inizi delle generazioni, per limitare gli errori HTTP 429.
MIN_GENERATION_INTERVAL_SECONDS=60
TRANSCRIPT_LANGUAGES=it
# Se i sottotitoli mancano o YouTube li blocca, prova il video pubblico con Gemini.
YOUTUBE_VIDEO_FALLBACK=true
# Opzionale: proxy HTTP/HTTPS per le richieste delle trascrizioni.
YOUTUBE_PROXY_URL=
